[Unit]
Description=LOQ Power daemon
Documentation=https://github.com/RoyChong5053/LOQ-power
After=dbus.service
Wants=dbus.service
# TLP must be disabled through the explicit takeover wizard, not by starting
# this unit. Conflicts= only prevents both from running at the same time.
Conflicts=tlp.service tlp-pd.service
ConditionPathExistsGlob=/sys/class/firmware-attributes/lenovo-wmi-other-*/attributes

[Service]
Type=simple
ExecStart=/usr/bin/loq-powerd
Restart=on-failure
RestartSec=2s

# The daemon owns /sys writes and speaks polkit on the system bus.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
