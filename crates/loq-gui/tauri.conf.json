{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOQ Power",
  "version": "0.1.0",
  "identifier": "org.loq.Power",
  "build": {
    "beforeDevCommand": "sh -c 'cd ../../ui && bun run dev'",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh -c 'cd ../../ui && bun run build'",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LOQ Power",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Power and EC control for Lenovo LOQ laptops",
    "longDescription": "LOQ Power manages EC power limits, thermal modes, battery charging, fans and power saving settings on Lenovo LOQ laptops.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
